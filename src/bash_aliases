# Copy terminal output to clipboard, e.g. '$ uptime | xc'.
alias xc="xclip -selection clipboard"

# Paste clipboard content into terminal.
#
#   NOTE: use ` `, e.g. '$ echo `xv`' or just '$ `xv`'.
#         The latter will execute pasted command.
alias xv="xclip -o"

# Usefull when you want to display tree for project directory
alias treegit="tree -aI .git --gitignore"

# Rust-powered enhanced 'cat' alternative with syntax highlight.
# Not working for Arch - program is already named 'bat'
# alias bat="batcat"

# Just a shortcut. There's also `nv` command available via script in `~/.local/bin/nv`.
alias v="nvim"

# Run fzf in current directory with nice preview enabled - requires both
# fzf and bat to be installed
alias fzp="fzf --multi --preview 'bat --color always {}'"

# Find a file and open with Neovim
nvf() {
  nvim -o $(fzf --multi --preview 'bat --color always {}' | tr '\n' ' ')
}

# Sync MEGA driva using rclone - push from local directory
# *NOTE*: You have to configure `rclone` first and create remote with a name MEGA
# *NOTE*: Files will be uploaded to remote `gen3` directory
alias msync='rclone sync /media/chester/DOCS/MEGA MEGA:gen3'

# use ffplay to loop sound infinitely
alias ffloop='ffplay -nodisp -autoexit -loop 0'

# VPN via WireGuard management
wqu() { sudo wg-quick up "proton-$1" }
wqd() { sudo wg-quick down "proton-$1" }
alias wql="sudo wql"
alias wqa="ip addr | grep proton- | cut -d' ' -f2 | sed 's/^proton-\([^:]*\):/\1/'"

alias mnt='sudo mnt'

alias ga='git add'
alias gall='git add --all'
alias gc='git commit'
alias gca='git commit --amend'
alias gd='git diff'
alias gl='git log --pretty=oneline'
alias gp='git push'
alias gpf='git push --force'
alias gst='git status'

function kanji() {
  local line
  line=$(cat -n $KANJI_DIC_DIRECTORY | rg "### $1" | cut -f1 | xargs)
  [ -n "$line" ] && nv +$line $KANJI_DIC_DIRECTORY
}

fzfrun() {
  local file
  file=$(fzf) || return 1
  setsid "$@" "$file" </dev/null >/dev/null 2>&1 &
}

pdf() {
 local file
 file=$(fd -e pdf | fzf) || return 1
 setsid evince "$file" </dev/null >/dev/null 2>&1 &
}

vid() { fzfrun mpv; }
